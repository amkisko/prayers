Package::Specification.new do |spec|
  spec.name = "amkisko/dependency-policy"
  spec.version = "3.1.0"
  spec.summary = "Dependency stop-gate and audit skill"
  spec.files = [
    "README.md",
    "exports/dependency-policy.md",
    "skills/dependency-audit/SKILL.md",
    "skills/dependency-audit/references/dependency-audit.md",
    "skills/dependency-audit/references/selection-and-alteration.md"
  ]
  spec.exports = {
    "dependency-policy" => {
      type: "fragment",
      path: "exports/dependency-policy.md",
      summary: "Stop-before-add gate and when to audit"
    },
    "skill" => {
      type: "folder",
      path: "skills/dependency-audit",
      summary: "Dependency audit skill"
    }
  }
end
